# Benefitly web application — local development template
# Copy this file to apps/web/.env.local. Do not commit .env.local.

# Neon PostgreSQL. Use the restricted application role, never the Neon owner role.
DATABASE_URL="postgresql://benefitly_app:REPLACE_WITH_PASSWORD@REPLACE_WITH_NEON_HOST/benefitly?sslmode=require"

# Better Auth. Generate a different 32+ byte random value for every environment.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="REPLACE_WITH_A_RANDOM_32_BYTE_SECRET"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,benefitly://,exp://**"

# Set this for local development and production/custom domains. Leave it unset on Vercel
# preview deployments so the browser automatically uses that preview's unique hostname.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Connect — use test-mode values while testing. Both server values are required before
# Stripe operations are enabled. The publishable key enables embedded payment forms.
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
STRIPE_CONNECT_ACCOUNT_TYPE="express"

# Optional services
RESEND_API_KEY="re_REPLACE_ME"
RESEND_FROM_EMAIL="Benefitly <noreply@example.test>"
SIGNALHOUSE_API_KEY="REPLACE_ME"
SIGNALHOUSE_FROM_NUMBER="+15555550100"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_REPLACE_ME"

# Optional Adyen for Platforms test configuration. Leave all unset unless Adyen is enabled.
# ADYEN_API_KEY=""
# ADYEN_HMAC_KEY=""
# ADYEN_MERCHANT_ACCOUNT=""
# ADYEN_BALANCE_PLATFORM=""
# ADYEN_ENVIRONMENT="TEST"
# ADYEN_LIVE_URL_PREFIX=""
