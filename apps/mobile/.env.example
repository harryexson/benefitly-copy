# Benefitly Expo application — local development template
# Copy this file to apps/mobile/.env. Values prefixed with EXPO_PUBLIC_ are embedded in the app;
# never put server secrets such as DATABASE_URL or Stripe secret keys here.

# Local web API (use your machine's LAN IP for a physical device).
EXPO_PUBLIC_API_URL="http://192.168.1.100:3000"

# Public Benefitly web origin used for campaign links.
EXPO_PUBLIC_APP_URL="http://localhost:3000"
